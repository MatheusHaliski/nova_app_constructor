# Copie para .env e ajuste. Nunca faça commit do .env.

# MySQL (fonte central de dados)
MYSQL_PASSWORD=nova_dev
MYSQL_ROOT_PASSWORD=root_dev

# Chaves JWT RS256 em PEM (PKCS#8 / X.509). Vazias = par temporário só para desenvolvimento.
# Gerar: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#        openssl rsa -in jwt.pem -pubout -out jwt.pub
NOVA_JWT_PRIVATE_KEY=
NOVA_JWT_PUBLIC_KEY=

# Primeiro administrador (criado na primeira inicialização, se ainda não existir)
NOVA_ADMIN_EMAIL=admin@nova.local
NOVA_ADMIN_PASSWORD=TroqueEsta123

# Conectores opcionais (desligados por padrão)
NOVA_REDIS_ENABLED=false
NOVA_OPENSEARCH_ENABLED=false
NOVA_S3_ENABLED=false
NOVA_CASSANDRA_ENABLED=false

# Copilot do NOVA (IA do formulário). Vazio = sugestões por regras simples, sem IA.
ANTHROPIC_API_KEY=
